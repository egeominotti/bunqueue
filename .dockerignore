# Build-context filter for builds from the repository root whose Dockerfile has no
# ignore file of its own: examples/postgres-multibroker/client.Dockerfile today.
# Dockerfile, Dockerfile.test and Dockerfile.sdk-test each use their own
# <Dockerfile>.dockerignore allow-list, which BuildKit prefers over this file.

# Dependencies
node_modules/

# Build output
dist/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
*.md
!README.md
docs/

# Tests
*.test.ts
*.spec.ts
__tests__/
coverage/
.nyc_output/

# Benchmarks
benchmarks/

# Local data
data/
*.db
*.db-wal
*.db-shm

# Environment files
.env
.env.*
!.env.example

# CI/CD
.github/

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Misc
*.log
*.tmp
.turbo/
