---
/**
 * Deployment topologies on /examples/: embedded, one TCP broker, or N brokers on
 * PostgreSQL. Each option is a real button with aria-pressed that shows one panel: a
 * one-line summary, the diagram (a role="img" whose text alternative names every
 * layer, node and link), and who owns durability. All panels share one grid cell, so
 * switching never changes the widget's height. A visually hidden live region
 * announces the new topology. The layout follows the widget's own width (container
 * queries in examples-topology.css).
 */
import './examples-explainers.css';
import './examples-topology.css';
import { describeTopology, resolveTopology, TOPOLOGIES } from './explainerModels';

const initialTopology = resolveTopology(undefined);
---

<bq-topology-explorer class="ex-panel ex-topology not-content" role="region" aria-label="Compare deployment topologies">
  <div class="ex-panel-body">
    <div class="ex-panel-head">
      <p class="ex-hint">Pick a topology. The Queue and Worker API stays familiar.</p>
      <div class="ex-choices" role="group" aria-label="Choose a deployment topology">
        {
          TOPOLOGIES.map((topology, index) => (
            <button
              type="button"
              data-topology-choice={topology.id}
              aria-controls={`topology-${topology.id}`}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {topology.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="ex-topology-stage ex-stack">
      {
        TOPOLOGIES.map((topology, topologyIndex) => (
          <section
            id={`topology-${topology.id}`}
            class="ex-topology-panel"
            data-topology-panel={topology.id}
            data-summary={topology.summary}
            hidden={topologyIndex > 0}
          >
            <p class="ex-topology-summary">{topology.summary}</p>
            <div class="ex-topology-visual" role="img" aria-label={describeTopology(topology)}>
              {topology.layers.map((layer, layerIndex) => (
                <>
                  {layerIndex > 0 && (
                    <div class="ex-topology-link">
                      <span class="ex-topology-link-label">{topology.links[layerIndex - 1]}</span>
                      <span class="ex-topology-wire" />
                    </div>
                  )}
                  <div class="ex-topology-layer">
                    <span class="ex-topology-layer-label">{layer.label}</span>
                    <div class="ex-topology-nodes">
                      {layer.nodes.map((node) => (
                        <span class="ex-topology-node">{node}</span>
                      ))}
                    </div>
                  </div>
                </>
              ))}
            </div>
            <dl class="ex-topology-facts">
              <div>
                <dt>Best fit</dt>
                <dd>{topology.bestFor}</dd>
              </div>
              <div>
                <dt>Durability owner</dt>
                <dd>{topology.durability}</dd>
              </div>
            </dl>
          </section>
        ))
      }
    </div>

    <p class="ex-sr" data-topology-status aria-live="polite" aria-atomic="true">
      {initialTopology.label}: {initialTopology.summary}
    </p>
  </div>
</bq-topology-explorer>

<script>
  class TopologyExplorerElement extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized === 'true') return;
      this.dataset.initialized = 'true';

      const choices = [...this.querySelectorAll<HTMLButtonElement>('[data-topology-choice]')];
      const panels = [...this.querySelectorAll<HTMLElement>('[data-topology-panel]')];
      const status = this.querySelector<HTMLElement>('[data-topology-status]');
      if (!choices.length || !panels.length || !status) return;

      choices.forEach((choice) => {
        choice.addEventListener('click', () => {
          const activeId = choice.dataset.topologyChoice;
          const panel = panels.find(({ dataset }) => dataset.topologyPanel === activeId);
          if (!panel) return;
          choices.forEach((item) => item.setAttribute('aria-pressed', String(item === choice)));
          panels.forEach((item) => (item.hidden = item !== panel));
          status.textContent = `${choice.textContent?.trim()}: ${panel.dataset.summary}`;
        });
      });
    }
  }

  if (!customElements.get('bq-topology-explorer')) {
    customElements.define('bq-topology-explorer', TopologyExplorerElement);
  }
</script>
