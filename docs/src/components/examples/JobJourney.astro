---
/**
 * One job through its states on /examples/: pick an outcome (succeeds first time,
 * fails once then succeeds, exhausts every attempt), then step through it. Each step
 * shows the state getJobState() would report, in the docs' job-state colors; an
 * attempt that throws also says "fails" (icon and text, not color alone). The card
 * under the rail explains the current step and holds the live region; invisible
 * copies of every step share its grid cell, so it never changes height. Previous/next
 * are real buttons marked aria-disabled at either end, so they keep focus. The layout
 * follows the widget's own width (container queries in examples-journey.css).
 */
import './examples-explainers.css';
import './examples-journey.css';
import { detailParts, JOB_JOURNEYS, type JourneyStep } from './explainerModels';

const journeys = Object.entries(JOB_JOURNEYS).map(([id, journey]) => ({
  id,
  label: journey.label,
  steps: journey.steps as readonly JourneyStep[],
}));
const [initialJourney] = journeys;
const initialStep = initialJourney.steps[0];
const allSteps = journeys.flatMap(({ steps }) => steps);
---

<bq-job-journey class="ex-panel ex-journey not-content" role="region" aria-label="Follow one job through its states">
  <div class="ex-panel-body">
    <div class="ex-panel-head">
      <p class="ex-hint">Pick an outcome, then step through the job's states.</p>
      <div class="ex-choices" role="group" aria-label="Choose the job outcome">
        {
          journeys.map(({ id, label }, index) => (
            <button type="button" data-journey-choice={id} aria-pressed={index === 0 ? 'true' : 'false'}>
              {label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="ex-route-stage ex-stack">
      {
        journeys.map(({ id, label, steps }, journeyIndex) => (
          <ol class="ex-route" role="list" data-journey-route={id} aria-label={`${label}: job states`} hidden={journeyIndex > 0}>
            {steps.map((step, stepIndex) => (
              <li
                data-state={stepIndex === 0 ? 'current' : 'upcoming'}
                data-job-state={step.state}
                data-fails={step.attemptFails ? 'true' : undefined}
                data-detail={step.detail}
                aria-current={stepIndex === 0 ? 'step' : undefined}
              >
                <span class="ex-route-node" aria-hidden="true">
                  {stepIndex + 1}
                </span>
                <span class="ex-route-label">{step.label}</span>
                <span class="ex-route-tags">
                  <span class="ex-state">{step.state}</span>
                  {step.attemptFails && (
                    <span class="ex-fail">
                      <span aria-hidden="true">✕</span> fails
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ol>
        ))
      }
    </div>

    <div class="ex-now ex-stack" data-journey-card data-job-state={initialStep.state}>
      <p class="ex-now-text" data-journey-status aria-live="polite" aria-atomic="true">
        <span class="ex-sr" data-journey-prefix>{initialJourney.label}. Step 1 of {initialJourney.steps.length}: </span>
        <span class="ex-now-head">
          <strong data-journey-label>{initialStep.label}</strong><span class="ex-sr">, state </span><span
            class="ex-state"
            data-journey-state>{initialStep.state}</span><span
            class="ex-fail"
            data-journey-fails
            hidden={!initialStep.attemptFails}><span class="ex-sr">, and this attempt</span><span
              aria-hidden="true">✕</span> fails</span><span class="ex-sr">. </span>
        </span>
        <span class="ex-now-detail" data-journey-detail>
          {detailParts(initialStep.detail).map(({ code, text }) => (code ? <code>{text}</code> : text))}
        </span>
      </p>
      {
        allSteps.map((step) => (
          <p class="ex-now-text ex-now-ghost" aria-hidden="true" data-pagefind-ignore>
            <span class="ex-now-head">
              <strong>{step.label}</strong>
              <span class="ex-state">{step.state}</span>
              {step.attemptFails && <span class="ex-fail">✕ fails</span>}
            </span>
            <span class="ex-now-detail">
              {detailParts(step.detail).map(({ code, text }) => (code ? <code>{text}</code> : text))}
            </span>
          </p>
        ))
      }
    </div>

    <div class="ex-step-controls">
      <button type="button" data-journey-action="previous" aria-disabled="true">
        <span aria-hidden="true">←</span> Previous<span class="ex-step-word"> state</span>
      </button>
      <span class="ex-step-count" data-journey-counter>Step 1 of {initialJourney.steps.length}</span>
      <button type="button" data-journey-action="next" aria-disabled="false">
        Next<span class="ex-step-word"> state</span> <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</bq-job-journey>

<script>
  import { clampJourneyStep, detailParts } from './explainerModels';

  class JobJourneyElement extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized === 'true') return;
      this.dataset.initialized = 'true';

      const choices = [...this.querySelectorAll<HTMLButtonElement>('[data-journey-choice]')];
      const routes = [...this.querySelectorAll<HTMLOListElement>('[data-journey-route]')];
      const previous = this.querySelector<HTMLButtonElement>('[data-journey-action="previous"]');
      const next = this.querySelector<HTMLButtonElement>('[data-journey-action="next"]');
      const counter = this.querySelector<HTMLElement>('[data-journey-counter]');
      const status = this.querySelector<HTMLElement>('[data-journey-status]');
      const prefix = this.querySelector<HTMLElement>('[data-journey-prefix]');
      const label = this.querySelector<HTMLElement>('[data-journey-label]');
      const state = this.querySelector<HTMLElement>('[data-journey-state]');
      const detail = this.querySelector<HTMLElement>('[data-journey-detail]');
      const card = this.querySelector<HTMLElement>('[data-journey-card]');
      const fails = this.querySelector<HTMLElement>('[data-journey-fails]');
      if (!choices.length || !routes.length || !previous || !next || !counter || !status) return;
      if (!prefix || !label || !state || !detail || !card || !fails) return;

      let activeId = routes[0].dataset.journeyRoute ?? 'success';
      let stepIndex = 0;

      const renderDetail = (text: string) => {
        detail.replaceChildren(
          ...detailParts(text).map((part) => {
            if (!part.code) return document.createTextNode(part.text);
            const code = document.createElement('code');
            code.textContent = part.text;
            return code;
          })
        );
      };

      // interactive = false syncs the rail and the buttons only. The server already
      // rendered the first step into the card, so the load-time sync never writes to
      // the live region and nothing is announced before the reader acts.
      const update = (interactive = true) => {
        const route = routes.find(({ dataset }) => dataset.journeyRoute === activeId) ?? routes[0];
        const steps = [...route.querySelectorAll<HTMLLIElement>('li')];
        stepIndex = clampJourneyStep(stepIndex, steps.length);
        steps.forEach((step, index) => {
          step.dataset.state = index < stepIndex ? 'done' : index === stepIndex ? 'current' : 'upcoming';
          if (index === stepIndex) step.setAttribute('aria-current', 'step');
          else step.removeAttribute('aria-current');
        });

        // aria-disabled rather than disabled: the button keeps focus at either end
        // (a disabled one would drop it to the page) and is announced as unavailable.
        previous.setAttribute('aria-disabled', String(stepIndex === 0));
        next.setAttribute('aria-disabled', String(stepIndex === steps.length - 1));

        if (!interactive) return;

        const current = steps[stepIndex];
        const jobState = current.dataset.jobState ?? 'waiting';
        const outcome = choices.find(({ dataset }) => dataset.journeyChoice === activeId)?.textContent?.trim();
        counter.textContent = `Step ${stepIndex + 1} of ${steps.length}`;
        prefix.textContent = `${outcome}. Step ${stepIndex + 1} of ${steps.length}: `;
        label.textContent = current.querySelector('.ex-route-label')?.textContent ?? '';
        state.textContent = jobState;
        fails.hidden = current.dataset.fails !== 'true';
        card.dataset.jobState = jobState;
        renderDetail(current.dataset.detail ?? '');

        card.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'nearest',
          inline: 'nearest',
        });
      };

      choices.forEach((choice) => {
        choice.addEventListener('click', () => {
          activeId = choice.dataset.journeyChoice ?? activeId;
          stepIndex = 0;
          choices.forEach((item) => item.setAttribute('aria-pressed', String(item === choice)));
          routes.forEach((route) => (route.hidden = route.dataset.journeyRoute !== activeId));
          update();
        });
      });
      const isUnavailable = (button: HTMLButtonElement) => button.getAttribute('aria-disabled') === 'true';
      previous.addEventListener('click', () => {
        if (isUnavailable(previous)) return;
        stepIndex--;
        update();
      });
      next.addEventListener('click', () => {
        if (isUnavailable(next)) return;
        stepIndex++;
        update();
      });
      update(false);
    }
  }

  if (!customElements.get('bq-job-journey')) {
    customElements.define('bq-job-journey', JobJourneyElement);
  }
</script>
