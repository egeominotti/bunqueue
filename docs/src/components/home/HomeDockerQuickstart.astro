---
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
import { SERVER_HEALTH_CHECK, dockerRunCommand } from '../../data/firstJob';

const variants = [
  { label: 'Alpine', tag: 'alpine', description: 'The default: a compact musl base with a shell and apk.' },
  { label: 'Debian', tag: 'debian', description: 'A full Debian base with glibc, a shell and apt.' },
  { label: 'Slim', tag: 'slim', description: 'Debian with glibc, a shell and apt, with fewer bundled utilities.' },
  { label: 'Distroless', tag: 'distroless', description: 'Required runtime libraries only. No shell or package manager.' },
];
---

<div class="home-docker-quickstart">
  <p class="home-step-lead">With Docker running, choose a base image and copy the command. No Bun installation needed.</p>
  <div class="home-docker-variants">
    <Tabs>
      {variants.map(({ label, tag, description }) => (
        <TabItem label={label}>
          <p class="home-note">{description} Same bunqueue features on AMD64 and ARM64.</p>
          <Code code={dockerRunCommand(tag)} lang="bash" />
        </TabItem>
      ))}
    </Tabs>
  </div>
  <p class="home-step-lead">Check that the server is ready:</p>
  <Code code={SERVER_HEALTH_CHECK} lang="bash" />
  <p class="home-note">Ports stay local to your machine. SQLite data persists in the <code>bunqueue-data</code> volume when you replace the container. Run one variant at a time. These tags follow new releases; pin a version or digest for deployment.</p>
</div>

<style>
  .home-docker-quickstart { min-width: 0; }
</style>
