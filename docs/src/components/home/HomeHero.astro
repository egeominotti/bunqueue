---
import '../../styles/home.css';
import '../../styles/home-setup.css';
import '../../styles/home-quickstart.css';
import '../../styles/home-sections.css';
import '../../styles/home-responsive.css';
import { getCollection } from 'astro:content';
import HomeLedger from './HomeLedger.astro';

// Like Bun's homepage pill: the newest release post, announced above the hero.
const releases = await getCollection('docs', (e) => /^blog\/bunqueue-v\d+-\d+-\d+$/.test(e.id));
const versionOf = (id: string) => id.replace('blog/bunqueue-v', '').split('-').map(Number);
const latestRelease = releases.sort((a, b) => {
  const [x, y] = [versionOf(a.id), versionOf(b.id)];
  return y[0] - x[0] || y[1] - x[1] || y[2] - x[2];
})[0];
---

<section class="home-hero bq-hero" aria-labelledby="home-title">
  <div class="home-hero-badges">
    <a class="home-license" href="https://github.com/egeominotti/bunqueue/blob/main/LICENSE">Free and open source <span>MIT licensed</span></a>
    {latestRelease && (
      <a class="home-announce" href={`/${latestRelease.id}/`}><span class="home-announce-tag">New</span> {latestRelease.data.title} is out <span aria-hidden="true">→</span></a>
    )}
  </div>
  <h1 id="home-title"><span>Add a background job in one language.</span> <span>Process it in another.</span></h1>
  <div class="home-hero-row">
    <p class="home-hero-sub">bunqueue is a free, self-hosted job queue for Node.js, Deno, Python, PHP, Go, Rust, Elixir and Bun. Run the server yourself, or embed the queue in a Bun app.</p>
    <div class="home-actions">
      <a class="home-button" href="#quickstart">Run your first job</a>
      <a class="home-button-secondary" href="https://github.com/egeominotti/bunqueue">Source on GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <HomeLedger />
</section>

<dl class="home-facts" aria-label="Included with bunqueue">
  <div><dt>Free, including the server</dt><dd>Every queue feature ships under MIT. There is no paid tier.</dd></div>
  <div><dt>Your infrastructure</dt><dd>Run it locally, on a VPS or in Docker, with SQLite or PostgreSQL.</dd></div>
  <div><dt>Bun app? Embed it</dt><dd>Queue and worker run in one process, with no server to operate.</dd></div>
</dl>
