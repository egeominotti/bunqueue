---
/**
 * How the web dashboard connects, for /guide/dashboard/: the browser talks only to
 * the dashboard process (bunx bunqueue-dashboard), whose UI server proxies /api/* to
 * the bunqueue HTTP API and whose control agent reaches the server's TCP port through
 * the SDKs. The optional Copilot is the one call that leaves the browser directly.
 * Plain HTML, so the text stays readable, selectable and in reading order for screen
 * readers; only the wires are hidden from them.
 */
import '../styles/dashboard-architecture.css';
---

<figure class="dashd not-content" aria-label="How the browser, the dashboard process and the bunqueue server connect">
  <div class="dashd-grid">
    <div class="dashd-node dashd-browser">
      <span class="dashd-kicker">Your browser</span>
      <strong class="dashd-title">Dashboard UI</strong>
      <span class="dashd-note">React app that polls the HTTP API and follows its SSE stream</span>
      <p class="dashd-aside"><strong>Optional Copilot</strong> calls your AI provider directly</p>
    </div>

    <div class="dashd-link dashd-link-browser">
      <span class="dashd-link-label">HTTP :8080</span>
      <span class="dashd-wire" aria-hidden="true"></span>
      <span class="dashd-link-sub">same origin</span>
    </div>

    <div class="dashd-node dashd-split dashd-process">
      <div class="dashd-head">
        <span class="dashd-kicker">bunqueue-dashboard</span>
        <strong class="dashd-title">Dashboard process</strong>
        <span class="dashd-note">npm package or standalone binary</span>
      </div>
      <div class="dashd-part">
        <strong class="dashd-title">UI server <code>:8080</code></strong>
        <span class="dashd-note">Serves the UI, proxies <code>/api/*</code> and bridges <code>/agent/*</code> to the agent</span>
      </div>
      <div class="dashd-part">
        <strong class="dashd-title">Control agent <code>127.0.0.1:6800</code></strong>
        <span class="dashd-note">Server process, SDK bridges, SQLite inspector, S3 backups</span>
      </div>
    </div>

    <ul class="dashd-links" role="list" aria-label="Connections to the bunqueue server">
      <li class="dashd-link">
        <span class="dashd-link-label">HTTP :6790</span>
        <span class="dashd-wire" aria-hidden="true"></span>
        <span class="dashd-link-sub">/api/* proxy</span>
      </li>
      <li class="dashd-link">
        <span class="dashd-link-label">TCP :6789</span>
        <span class="dashd-wire" aria-hidden="true"></span>
        <span class="dashd-link-sub">SDK bridges</span>
      </li>
    </ul>

    <div class="dashd-node dashd-split dashd-server">
      <div class="dashd-head">
        <span class="dashd-kicker">Self-hosted</span>
        <strong class="dashd-title">bunqueue server</strong>
        <span class="dashd-note">SQLite or PostgreSQL</span>
      </div>
      <div class="dashd-part">
        <strong class="dashd-title">HTTP API <code>:6790</code></strong>
        <span class="dashd-note">Reads, writes and the SSE stream</span>
      </div>
      <div class="dashd-part">
        <strong class="dashd-title">TCP <code>:6789</code></strong>
        <span class="dashd-note">Client SDKs and workers</span>
      </div>
    </div>
  </div>
</figure>
