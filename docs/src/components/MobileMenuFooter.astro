---
import Default from '@astrojs/starlight/components/MobileMenuFooter.astro';

/**
 * Adds the site nav links to Starlight's mobile drawer. On phones the
 * header collapses to logo + search + CTA, so the header links (Academy,
 * AI Agents, Dashboard, Blog) live here instead.
 */
---

<nav class="bq-mobile-nav" aria-label="Site">
  <a href="/academy/">Academy</a>
  <a href="/guide/mcp/">AI Agents</a>
  <a href="/guide/dashboard/">Dashboard</a>
  <a href="/blog/">Blog</a>
</nav>
<Default><slot /></Default>

<style>
  .bq-mobile-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0.85rem var(--sl-sidebar-pad-x, 1rem);
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .bq-mobile-nav a {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .bq-mobile-nav a:hover {
    color: var(--sl-color-white);
  }
</style>
