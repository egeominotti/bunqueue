---
/**
 * Where the queue lives, for /guide/mcp/: the AI client talks to bunqueue-mcp over
 * stdio or Streamable HTTP, and the MCP server keeps the queue either inside its own
 * process (embedded, the default) or on your bunqueue server (TCP). Plain HTML, so
 * the text stays readable, selectable and in reading order for screen readers.
 */
import '../styles/mcp-architecture.css';
---

<figure class="mcpd not-content" aria-label="How an AI client reaches the queue through the bunqueue MCP server">
  <div class="mcpd-grid">
    <div class="mcpd-node">
      <span class="mcpd-kicker">Your AI client</span>
      <strong class="mcpd-title">Claude Code, Claude Desktop, Cursor, Windsurf</strong>
      <span class="mcpd-note">Any client that speaks MCP</span>
    </div>

    <div class="mcpd-link">
      <span class="mcpd-link-label">stdio or Streamable HTTP</span>
      <span class="mcpd-wire" aria-hidden="true"></span>
      <span class="mcpd-link-sub">JSON-RPC</span>
    </div>

    <div class="mcpd-node mcpd-server">
      <span class="mcpd-kicker">bunqueue-mcp</span>
      <strong class="mcpd-title">75 tools, 3 prompts, 5 resources</strong>
      <ul class="mcpd-chips" role="list" aria-label="Optional features">
        <li class="mcpd-chips-label" aria-hidden="true">optional</li>
        <li>toolsets</li>
        <li>confirmations</li>
        <li>decision models</li>
      </ul>
    </div>

    <div class="mcpd-fork" aria-hidden="true">
      <span class="mcpd-fork-stem"></span>
      <span class="mcpd-fork-bar"></span>
    </div>

    <ul class="mcpd-modes" role="list" aria-label="Where the queue lives">
      <li class="mcpd-node mcpd-mode">
        <span class="mcpd-kicker">Embedded <em class="mcpd-default">default</em></span>
        <strong class="mcpd-title">Inside the MCP server</strong>
        <span class="mcpd-note">In memory, or a SQLite file with <code>DATA_PATH</code></span>
      </li>
      <li class="mcpd-node mcpd-mode">
        <span class="mcpd-kicker">TCP <code>BUNQUEUE_MODE=tcp</code></span>
        <strong class="mcpd-title">Your bunqueue server, port 6789</strong>
        <span class="mcpd-note">SQLite or PostgreSQL, shared with your workers</span>
      </li>
    </ul>
  </div>
</figure>
