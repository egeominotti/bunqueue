---
/**
 * What happens to a job on a queue with an HTTP handler, for /guide/mcp/: it is
 * added, a handler worker inside the MCP server takes it, calls your URL, and the
 * response settles it. Job states use the docs' --docs-state-* tokens (waiting,
 * active, completed, failed), the same palette as the homepage ledger. Plain HTML in reading order, so screen readers get the steps.
 */
---

<figure class="hfd not-content" aria-label="How an HTTP handler processes a job">
  <ol class="hfd-steps" role="list">
    <li class="hfd-step">
      <span class="hfd-num" aria-hidden="true">1</span>
      <span class="hfd-state hfd-waiting">waiting</span>
      <strong class="hfd-title">A job is added</strong>
      <span class="hfd-note">By the agent, by a cron or, in TCP mode, by any app on your server</span>
    </li>
    <li class="hfd-step">
      <span class="hfd-num" aria-hidden="true">2</span>
      <span class="hfd-state hfd-active">active</span>
      <strong class="hfd-title">The handler takes it</strong>
      <span class="hfd-note">A worker inside the MCP server; in TCP mode it pulls from your server</span>
    </li>
    <li class="hfd-step">
      <span class="hfd-num" aria-hidden="true">3</span>
      <span class="hfd-state hfd-active">active</span>
      <strong class="hfd-title">It calls your URL</strong>
      <span class="hfd-note"><code>GET</code> <code>POST</code> <code>PUT</code> <code>DELETE</code>; POST and PUT send the job's data, or your fixed body. It waits up to <code>timeoutMs</code></span>
    </li>
    <li class="hfd-step hfd-outcomes">
      <span class="hfd-num" aria-hidden="true">4</span>
      <ul class="hfd-split" role="list" aria-label="Outcome">
        <li>
          <span class="hfd-state hfd-completed">completed</span>
          <strong class="hfd-title">2xx response</strong>
          <span class="hfd-note">The response is saved as the job's result</span>
        </li>
        <li>
          <span class="hfd-state hfd-failed">failed</span>
          <strong class="hfd-title">Error status, network error or timeout</strong>
          <span class="hfd-note">Retried with backoff while attempts remain, then moved to the dead letter queue</span>
        </li>
      </ul>
    </li>
  </ol>
</figure>

<style>
  .hfd {
    container: hfd / inline-size;
    margin: 2rem 0;
    padding: 1.5rem;
    border: 1px solid var(--docs-line);
    border-radius: var(--docs-radius);
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--sl-color-text) 9%, transparent) 1px, transparent 0)
        0 0 / 18px 18px,
      var(--sl-color-bg);
  }

  .hfd-steps {
    --hfd-gap: 1.75rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.2fr);
    align-items: center;
    gap: var(--hfd-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .hfd-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    margin: 0;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--docs-line);
    border-radius: var(--docs-radius);
    background: var(--docs-panel);
  }

  /* The arrow to the next step sits in the gap. */
  .hfd-step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: calc(var(--hfd-gap) * -1 + 4px);
    width: calc(var(--hfd-gap) - 8px);
    height: 1px;
    background: var(--docs-muted);
  }

  .hfd-step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: calc(50% - 3.5px);
    right: calc(var(--hfd-gap) * -1 + 4px);
    width: 8px;
    height: 8px;
    border-top: 1px solid var(--docs-muted);
    border-right: 1px solid var(--docs-muted);
    transform: rotate(45deg);
  }

  .hfd-num {
    position: absolute;
    top: -0.7rem;
    left: 0.75rem;
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border: 1px solid var(--docs-line);
    border-radius: 50%;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: 0.72rem;
    font-weight: 650;
  }

  .hfd-title {
    color: var(--sl-color-text);
    font-size: 0.92rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .hfd-note {
    color: var(--docs-muted);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  /* Outranks custom.css's global inline-code chip, which also reaches .not-content. */
  .hfd.not-content :not(pre) > code {
    padding: 0.02em 0.3em;
    border-radius: 4px;
    background: color-mix(in srgb, var(--sl-color-text) 8%, transparent);
    color: var(--sl-color-text);
    font-size: 0.85em;
  }

  /* Job states, in the colors the docs use for them everywhere. */
  .hfd-state {
    --hfd-state: var(--docs-muted);
    align-self: flex-start;
    margin-top: 0.35rem;
    padding: 0 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--hfd-state) 15%, transparent);
    color: var(--hfd-state);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    line-height: 1.6;
  }

  .hfd-waiting {
    --hfd-state: var(--docs-state-waiting);
  }

  .hfd-active {
    --hfd-state: var(--docs-state-active);
  }

  .hfd-completed {
    --hfd-state: var(--docs-state-completed);
  }

  .hfd-failed {
    --hfd-state: var(--docs-state-failed);
  }

  /* The last step splits into its two outcomes. */
  .hfd-outcomes {
    padding: 0;
    border: 0;
    background: none;
  }

  .hfd-split {
    display: grid;
    gap: 0.6rem;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hfd-split > li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--docs-line);
    border-left: 2px solid var(--hfd-outcome);
    border-radius: var(--docs-radius);
    background: var(--docs-panel);
  }

  .hfd-split > li:first-child {
    --hfd-outcome: var(--docs-state-completed);
  }

  .hfd-split > li:last-child {
    --hfd-outcome: var(--docs-state-failed);
  }

  .hfd-split .hfd-state {
    margin-top: 0;
  }

  .hfd-outcomes > .hfd-num {
    left: 0.75rem;
    z-index: 1;
  }

  @media (max-width: 30rem) {
    .hfd {
      padding: 1.25rem 1rem 1rem;
    }
  }

  /* Narrow figures (the layout follows the figure's width, not the window's): steps
     top to bottom, arrows pointing down. */
  @container hfd (max-width: 45.99rem) {
    .hfd-steps {
      --hfd-gap: 1.6rem;
      grid-template-columns: minmax(0, 1fr);
    }

    /* Centered, clear of the number badge at the next step's top-left corner. */
    .hfd-step:not(:last-child)::after {
      top: auto;
      right: auto;
      bottom: calc(var(--hfd-gap) * -1 + 4px);
      left: 50%;
      width: 1px;
      height: calc(var(--hfd-gap) - 8px);
    }

    .hfd-step:not(:last-child)::before {
      top: auto;
      right: auto;
      bottom: calc(var(--hfd-gap) * -1 + 4px);
      left: calc(50% - 3.5px);
      transform: rotate(135deg);
    }
  }
</style>
