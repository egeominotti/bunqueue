#!/bin/sh

echo "🔍 Running pre-commit checks..."

# Type check
echo "📘 TypeScript check..."
bun run typecheck
if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors found. Commit aborted."
  exit 1
fi

# Format verification (bun fmt)
echo "🔎 Format check..."
bun run format:check
if [ $? -ne 0 ]; then
  echo "❌ Format errors found. Run 'bun run format' to fix."
  exit 1
fi

echo "✅ All checks passed!"
